# Opcional: copie para .env somente para testar pelo celular (o navegador usa localhost).
# Troque pelo IPv4 do seu computador, que aparece no comando ipconfig. Sem barra no final.
# O valor fica visível dentro do aplicativo: nunca coloque senhas em variáveis EXPO_PUBLIC_.
EXPO_PUBLIC_API_URL=http://192.168.0.20:3000
