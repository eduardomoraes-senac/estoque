{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "types": ["react"]
  },
  "include": ["App.js", "index.js", "screens/**/*.js", "components/**/*.js", "data/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
