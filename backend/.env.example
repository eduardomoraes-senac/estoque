# Copie este arquivo para backend/.env e preencha com os dados do SEU MySQL.
# backend/.env fica fora do Git: nunca envie sua senha para o repositório.
PORT=3000

DB_HOST=localhost
# A porta padrão do MySQL é 3306. Confira a sua no MySQL Workbench (a instalação pode usar outra, como 3307).
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=despensa_em_dia
